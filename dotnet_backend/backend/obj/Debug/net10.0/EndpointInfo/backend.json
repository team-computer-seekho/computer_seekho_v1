  "components": {
    "schemas": {
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "required": [
          "token",
          "expiresInMs",
          "staff"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresInMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "staff": {
            "$ref": "#/components/schemas/StaffDto"
          }
        }
      },
      "StaffCreateRequest": {
        "required": [
          "name",
          "email",
          "role",
          "username"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 150,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "type": "string"
          },
          "phone": {
            "pattern": "^$|^[6-9]\\d{9}$",
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "type": "string"
          },
          "qualification": {
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ]
          },
          "experience": {
            "maximum": 60,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "photoUrl": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "maxLength": 50,
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "type": [
              "null",
              "string"
            ]
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "StaffDto": {
        "required": [
          "staffId",
          "name",
          "email",
          "phone",
          "role",
          "qualification",
          "experience",
          "photoUrl",
          "username",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "staffId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "type": [
              "null",
              "string"
            ]
          },
          "qualification": {
            "type": [
              "null",
              "string"
            ]
          },
          "experience": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "photoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "isActive": {
            "type": "boolean"
          }
        }
      }
    }
  },
